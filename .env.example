# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# GSM SMS backup (optional), include the country code
GUARDIAN_EMERGENCY_PHONE=

# Camera stream protection (optional)
# Set a long random token to require ?token=... on /video_feed.
# Leave empty to keep the current open LAN stream.
CAMERA_STREAM_TOKEN=

# Comma-separated browser origins allowed to load the stream.
# Leave empty for the current permissive behavior (CORS "*").
# Example: http://localhost:5173,http://192.168.1.20:5173
CORS_ORIGINS=
