rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidEmergency(data) {
      return data.keys().hasOnly(['reason', 'status', 'timestamp'])
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 200
        && data.status == 'active'
        && data.timestamp == request.time;
    }

    // Each signed-in guardian can only read and acknowledge their own events.
    // The Python edge engine writes with the Firebase Admin SDK, which bypasses
    // these rules. Browser clients can create a test alert and resolve alerts,
    // but cannot rewrite the reason, timestamp, or delete history.
    match /users/{userId}/emergencies/{emergencyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidEmergency(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'resolved';
      allow delete: if false;
    }

    // No other client access is allowed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
