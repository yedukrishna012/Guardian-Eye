# Firebase web app configuration (required for account + dashboard routes).
# Copy this file to .env.local and fill in the values from:
# Firebase console -> Project settings -> Your apps -> Web app.
#
# These values are bundled into the browser build. They are not secrets, but
# access must be controlled with Firebase Authentication and Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional default token for the local camera stream modal. The value is
# visible in the client bundle, so only use it for a trusted LAN. Leave empty
# to type the token into the camera dialog instead.
VITE_CAMERA_STREAM_TOKEN=
